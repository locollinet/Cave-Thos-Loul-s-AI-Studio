GEMINI_API_KEY=
GEMINI_MODEL=
# Modèle dédié à l'assistant (défaut : gemini-4-hydrogen puis repli gemini-3.8-flash)
# GEMINI_ASSISTANT_MODEL=gemini-4-hydrogen
# Fournisseur IA : gemini (défaut) ou vertex (Vertex AI Europe)
# AI_BACKEND=gemini
# VERTEX_PROJECT=
# VERTEX_LOCATION=europe-west1
# IA sans compte en production : on (défaut, quotas par IP) ou off
DEMO_AI=
# Plafond horaire global des appels IA sans compte (défaut 600)
AI_ANON_PER_HOUR=
# CSP en production : enforce (défaut), report-only ou off
CSP_MODE=
# Sites autorisés à afficher l'app dans un cadre (défaut 'self')
FRAME_ANCESTORS=
# Nombre de proxys devant le serveur (Cloud Run : 1)
TRUST_PROXY=